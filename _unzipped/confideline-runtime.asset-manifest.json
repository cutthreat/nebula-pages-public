{
  "schema": "confideline_runtime_asset_manifest.v1",
  "page": "home",
  "status": "assetbundle_ready_preview",
  "runtime": {
    "yii": "2.0.55",
    "php": "8.5.0",
    "mysql": "8.0.41",
    "bootstrap": "4.6",
    "jquery": "3.x"
  },
  "rules": {
    "library_upgrades": false,
    "vendor_edits": false,
    "global_style_rewrite": false,
    "scope": ".home"
  },
  "css_order": [
    "bootstrap.css",
    "home.css",
    "home-reverse-type-owner.css",
    "home-reverse-shell-owner.css",
    "confideline-runtime.css",
    "confideline-components.css"
  ],
  "js_order": [
    "jquery.js",
    "bootstrap.js",
    "home.js"
  ],
  "yii2_assetbundle_shape": {
    "css": [
      "css/bootstrap.css",
      "css/home.css",
      "css/home-reverse-type-owner.css",
      "css/home-reverse-shell-owner.css",
      "css/confideline-runtime.css",
      "css/confideline-components.css"
    ],
    "js": [
      "js/jquery.js",
      "js/bootstrap.js",
      "js/home.js"
    ],
    "depends": [
      "yii\\web\\YiiAsset",
      "yii\\bootstrap4\\BootstrapAsset",
      "yii\\bootstrap4\\BootstrapPluginAsset"
    ]
  }
}
